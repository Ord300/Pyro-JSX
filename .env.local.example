# ── COPIEZ ce fichier vers .env.local et renseignez vos valeurs ──
# .env.local est ignoré par Git (*.local) → vos secrets ne seront jamais commités.

# Gmail SMTP — voir guide dans le README ou demandez à l'assistant
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre.email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="MoveUp Centre Sportif <votre.email@gmail.com>"
NEXT_PUBLIC_APP_NAME="MoveUp — Centre Sportif"
